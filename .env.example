# 可选：只有抖音提示登录或风控时才需要填写。请勿分享真实 Cookie。
DOUYIN_COOKIE=""
# 可选：默认将音频与数据库保存在启动目录的 data/。
# DLS_DATA_DIR="/absolute/path/to/data"
# 可选高级回退：通常在网页“网站配置”保存 Token，不需要填写这里。
HF_TOKEN=""
# HTTP 监听配置。默认只允许本机访问。
# DLS_HOST="127.0.0.1"
# DLS_PORT="8787"
# 反向代理或 tunnel 的域名必须加入此列表。
# DLS_ALLOWED_HOSTS="127.0.0.1,localhost"
# 反代使用 HTTPS 时设为 true，使登录 Cookie 和客户端 IP 正确处理。
# DLS_TRUST_PROXY="false"
# auto 按请求协议决定 Secure；也可设为 always 或 never。
# DLS_SECURE_COOKIES="auto"
# 登录 Cookie 有效期，范围 1-90 天。
# DLS_SESSION_DAYS="7"
# 自动化部署时设置；交互式部署请让 setup.sh 生成并打印一次密码。
# DLS_ADMIN_PASSWORD=""
# 分析进程 CPU 线程数，默认 4。
# DLS_ANALYSIS_THREADS="4"
# 人物判断默认自动选择 CUDA、Apple MPS 或 CPU。普通话转写使用 CPU。
# DLS_DIARIZATION_DEVICE="auto"
